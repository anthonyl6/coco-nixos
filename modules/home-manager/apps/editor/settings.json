{
  "collaboration_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "right"
  },
  "search": {
    "center_on_match": true
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "git_panel": {
    "dock": "right",
    "tree_view": true
  },
  "icon_theme": "Catppuccin Latte",
  "agent": {
    "favorite_models": [
      {
        "provider": "anthropic",
        "model": "claude-sonnet-4-6"
      },
      {
        "provider": "anthropic",
        "model": "claude-opus-4-6"
      },
      {
        "provider": "anthropic",
        "model": "claude-haiku-4-5-20251001"
      },
      {
        "provider": "openrouter",
        "model": "moonshotai/kimi-k2.5"
      },
      {
        "provider": "openrouter",
        "model": "google/gemini-3-flash-preview"
      },
      {
        "provider": "openrouter",
        "model": "google/gemini-3-pro-preview"
      },
      {
        "provider": "openrouter",
        "model": "openrouter/auto"
      }
    ],
    "default_model": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-6"
    },
    "commit_message_model": {
      "provider": "openrouter",
      "model": "google/gemini-3-flash-preview"
    },
    "dock": "left",
    "model_parameters": []
  },
  "project_panel": {
    "dock": "right"
  },
  "edit_predictions": {
    "provider": "mercury",
    "mode": "eager",
    "enabled_in_text_threads": true,
    "disabled_globs": [
      "**/.env",
      "**/.env.*",
      "**/*.pem",
      "**/*.key",
      "**/*.cert",
      "**/*.crt",
      "**/.dev.vars",
      "**/secrets.yml"
    ]
  },
  "private_files": [
    "**/.env",
    "**/.env.*",
    "**/*.pem",
    "**/*.key",
    "**/*.cert",
    "**/*.crt",
    "**/.dev.vars",
    "**/secrets.yml"
  ],
  "scroll_beyond_last_line": "vertical_scroll_margin",
  "terminal": {
    "font_size": 16.0
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "base_keymap": "VSCode",
  "relative_line_numbers": "enabled",
  "gutter": {
    "line_numbers": true
  },
  "cursor_blink": true,
  "indent_guides": {
    "enabled": false
  },
  "tab_size": 2,
  "helix_mode": false,
  "lsp": {
    "nil": {
      "initialization_options": {
        "nix": {
          "flake": {
            "autoArchive": true,
            "autoEvalInputs": false,
            "nixpkgsInputName": "nixpkgs"
          }
        },
        "formatting": {
          "command": ["alejandra", "--quiet", "--"]
        }
      }
    },
    "nixd": {
      "initialization_options": {
        "formatting": {
          "command": ["alejandra", "--quiet", "--"]
        }
      }
    }
  },
  "window_decorations": "server",
  "window_background_opacity": 0.85,
  "which_key": {
    "enabled": true,
    "delay_ms": 50
  },
  "hide_mouse": "on_typing_and_movement",
  "auto_install_extensions": {
    "catppuccin-icons": true,
    "discord-presence": true,
    "ghostty": true,
    "html": true,
    "java": true,
    "nix": true,
    "prisma": true,
    "sql": true,
    "toml": true
  },
  "language_models": {
    "anthropic": {
      "available_models": [
        {
          "name": "claude-sonnet-4-6",
          "display_name": "Claude Sonnet 4.6",
          "max_tokens": 200000,
          "max_output_tokens": 16000
        },
        {
          "name": "claude-opus-4-6",
          "display_name": "Claude Opus 4.6",
          "max_tokens": 200000,
          "max_output_tokens": 16000
        },
        {
          "name": "claude-haiku-4-5-20251001",
          "display_name": "Claude Haiku 4.5",
          "max_tokens": 200000,
          "max_output_tokens": 16000
        }
      ]
    },
    "open_router": {
      "api_url": "https://openrouter.ai/api/v1",
      "available_models": []
    }
  },
  "minimap": {
    "show": "auto",
    "thumb": "hover"
  },
  "soft_wrap": "editor_width",
  "title_bar": {
    "show_branch_icon": true,
    "show_sign_in": false,
    "show_user_picture": false,
    "show_user_menu": false
  },
  "linked_edits": true,
  "show_whitespaces": "boundary"
}
